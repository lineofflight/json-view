{
  "manifest_version": 3,
  "name": "Tidy JSON",
  "version": "0.1.1",
  "description": "Tidy up JSON documents into a clean, collapsible tree.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ]
}
